# Optional. The defaults already run an open-weight model locally via Ollama,
# which needs no key — copy this file to .env only to point somewhere else.
# .env is gitignored and never committed.

# Local Ollama (the default — no key required)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:latest

# Groq — open-weight Llama, hosted
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...
